# FRP-SSH-Guard settings (literal KEY=value assignments; no shell execution).
# Edit this file, then: sudo frp-ssh-guard check && sudo frp-ssh-guard reload
# First activation: sudo frp-ssh-guard enable
# Saving alone does not change protection; reboot restores accepted settings.

# === Ports and protection switches ===
# Public frps forwarded TCP ports. Empty refuses activation unless local SSH is on.
# Port numbers below are invented examples, not a deployment configuration.
# Comma-separated ports/ranges; never include management SSH, frps control ports,
# or public HTTP(S). Enable server SSH separately below. Start listeners first.
# Example: PROTECTED_PORTS="22001,22003,23000-23010"
# Optional per-port/range global rate and burst: "22001:30:20,23000-23010:60:40"
PROTECTED_PORTS=""

# Ports/ranges to skip within PROTECTED_PORTS. Default none.
# Example: EXCLUDE_PORTS="23005,23008-23009"
EXCLUDE_PORTS=""

# PROTECT_SERVER_SSH: local SSH protection switch (on/off).
# Protect this server's SSH port 22, including observed authentication failures.
# Default off. When enabled, port 22 is added to the protected ports automatically.
PROTECT_SERVER_SSH=off

# JAIL_PER_PORT: jail scope switch (on/off); port rate limits remain enabled.
# Default off: a banned IP is blocked across ALL protected ports.
# On: automatic and authentication bans apply only to the offending port.
# Switching mode affects NEW bans only. Existing shared bans stay shared;
# existing per-port bans keep their original ports and absolute expiry.
# Strike history retains each offense's original scope across mode switches.
# Explicit manual block scopes are independent of this switch.
JAIL_PER_PORT=off

# === Local SSH authentication thresholds ===
# Local sshd journal outcomes only; attempted passwords are never read or stored.
# Count repeated invalid-user connections or failed authentications in this window.
SSH_AUTH_FAILURES=5
SSH_INVALID_USER_FAILURES=3
SSH_AUTH_WINDOW=10m

# Independent long-window detector, active only when PROTECT_SERVER_SSH=on.
# Fresh installs enforce the existing ban duration and jail scope at the threshold.
# observe reports without bans/strikes; off disables the long-window detector.
# Upgrades preserve existing choices; legacy missing settings retain observe.
SSH_SLOW_MODE=enforce
SSH_SLOW_FAILURES=20
SSH_SLOW_WINDOW=24h

# Local alerts: newest complete record first, discard oldest records at the cap.
# No rotated archives or remote notifications. Accepted settings change on reload.
ALERT_LOG_MAX_SIZE=10MiB
# Report suspected subnet clusters only; never automatically block a subnet.
# Count distinct automatically banned sources per jail scope (IPv4 /24, IPv6 /64).
SUBNET_REPORT_MIN_SOURCES=5
SUBNET_REPORT_WINDOW=24h

# === Connection limits and ban duration ===
# Per source AND destination port: sustained new SYN packets/minute, not logins.
# Positive integers 1–1000000. Default 2/minute with a burst allowance of 40.
# Shared NAT/VPN users count together. Bursts replenish over time, not per minute.
PER_IP_RATE=2
PER_IP_BURST=40

# Shared new SYN ceiling per destination port (shared across IPv4/IPv6).
# Positive integers 1–1000000. Default 30/minute, burst 20. Excess is dropped;
# the shared limit alone does not add IP bans. Per-port overrides take precedence.
GLOBAL_RATE=30
GLOBAL_BURST=20

# Base source ban when the per-source or local authentication limit is exceeded.
# Scope is all protected ports unless JAIL_PER_PORT=on.
# Positive integer + s/m/h/d/w (seconds/minutes/hours/days/weeks). Default 6 hours.
BAN_TIMEOUT=6h

# Optional learning from successful logins to THIS SERVER's sshd, not tunneled SSH.
# Default empty = disabled. grep extended regex, e.g. "alice|bob".
# Matching source IPs bypass guard limits/blocks; also exempted from an existing
# fail2ban sshd jail. Enable only for trusted operator accounts.
LOGIN_USERS=""

# Maximum learned addresses (integer 1–1000000); oldest entries evicted. Default 500.
MAX_LEARNED=500
# Learned-address timeout: positive integer + s/m/h/d/w; default 90 days.
# Trusted successful logins refresh this expiry; apply/reload/reboot do not.
LEARN_TIMEOUT=90d

# Repeat-offender history window; positive integer + s/m/h/d/w. Default 90 days.
# Bans are sampled every minute: short bans and repeated events may be missed.
STRIKE_WINDOW=90d
# Increasing "strike-count:duration" pairs, counts >=2. Empty disables escalation.
# Default: 2 offenses=1 day, 3=3 days, 4=7 days, 5 or more=28 days.
STRIKE_LADDER="2:1d 3:3d 4:7d 5:28d"
# Maximum strike duration from the latest offense. Default 28 days.
# The strike helper caps ladder durations at this value.
STRIKE_MAX=28d

# Advanced settings (usually leave unchanged).
# Allowed protected-port bounds, inclusive, integers 1–65535. Defaults cover all TCP.
PORT_MIN=1
PORT_MAX=65535
# Local account owning command-managed lists. Default root; trusted accounts only.
EDIT_USER=root
# Dedicated nftables table identifier. One guard instance is supported.
# Default below; to change while active: disable first, then enable with new name.
GUARD_TABLE=frp_ssh_persistent_guard
