# FRP-SSH-Guard settings
#
# Nothing changes until you run:
#   sudo frp-ssh-guard check && sudo frp-ssh-guard reload
# (Use enable instead of reload the first time.) Current bans are kept.
# Most people only need to set PROTECTED_PORTS. Times look like 30s 10m 12h 7d 4w.

# === 1. Ports to protect ===
# Public frps ports that forward SSH. Not the frps control port or web ports.
# Example: PROTECTED_PORTS="22001,22003,23000-23010"
PROTECTED_PORTS=""
# Ports to skip inside that list. Example: EXCLUDE_PORTS="23005,23008-23009"
EXCLUDE_PORTS=""
# Also protect this server's own SSH on port 22 (on/off).
PROTECT_SERVER_SSH=off

# === 2. What a ban does ===
# Length of a first ban. For a permanent block, use blocklist.conf.
BAN_TIMEOUT=12h
# Longer bans for repeat offenders, as "offense:duration". Empty turns this off.
STRIKE_LADDER="2:3d 3:7d 4:30d 5:90d"
# off: a ban covers every protected port. on: only the attacked port.
JAIL_PER_PORT=off

# === 3. Catching attackers ===
# Detect attacks that stay under the per-minute limits (on/off).
SSH_SLOW_PROTECTION=on
# Ban sources by the patterns below (on/off). Needs the switch above.
SSH_SLOW_BEHAVIOR=on
# Only sources that never completed a login are judged:
#   20b:30m  about 20 connections within 30 minutes: banned at once
#   4p:2h    4 different ports during 2 hours of steady attempts
#   3p:6h    3 different ports during 6 hours of steady attempts
#   50c:12h  50 connections during 12 hours of steady attempts
# Whitelist monitoring, CI and scripts that make many short connections.
SSH_BEHAVIOR_RULES="20b:30m 4p:2h 3p:6h 50c:12h"

# === 4. Protecting real users ===
# Trust a source after an administrator logs in to this server (on/off).
LEARN_ADMINS=on
# Stop counting a source on a port once it has held a real session (on/off).
LEARN_USERS=on

# === 5. Rate limits ===
# Per source and port: new connections per minute, and the burst allowed.
PER_IP_RATE=2
PER_IP_BURST=40
# Per port, all sources together. Excess is dropped; nobody is banned.
GLOBAL_RATE=30
GLOBAL_BURST=20

# === Advanced (optional) ===
# These are the defaults. To change one, remove the leading "# ".
# Each is explained in docs/SETTINGS.md (packages: /usr/share/doc/frp-ssh-guard/).
# SSH_AUTH_FAILURES=5
# SSH_INVALID_USER_FAILURES=3
# SSH_AUTH_WINDOW=10m
# SSH_SLOW_TOTAL_CONNECTIONS=300
# SSH_SLOW_PORT_CONNECTIONS=100
# SSH_SLOW_FAILURES=20
# SSH_SLOW_WINDOW=24h
# SSH_BEHAVIOR_PAUSE=2h
# LOGIN_USERS=""
# MAX_LEARNED=500
# LEARN_TIMEOUT=90d
# LEARN_SESSION_AGE=3m
# LEARN_SESSION_BYTES=32KiB
# STRIKE_WINDOW=90d
# STRIKE_MAX=90d
# LOG_MAX_SIZE=10MiB
# SUBNET_REPORT_MIN_SOURCES=5
# SUBNET_REPORT_WINDOW=24h
# PORT_MIN=1
# PORT_MAX=65535
# EDIT_USER=root
# GUARD_TABLE=frp_ssh_persistent_guard
