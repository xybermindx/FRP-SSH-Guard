# FRP-SSH-Guard settings (literal KEY=value assignments; no shell execution).
#
# === When and how changes take effect ===
# Saving this file changes nothing yet. The running guard, and every reboot,
# keep using the last ACCEPTED settings until you accept your edits:
#   1. Save your edits here.
#   2. sudo frp-ssh-guard check     validate only; nothing changes
#   3. sudo frp-ssh-guard reload    guard already running: accept and apply now
#      sudo frp-ssh-guard enable    first activation, or after disable
#   4. sudo frp-ssh-guard status    shows "Pending edits: no" once accepted
# Short form: sudo frp-ssh-guard check && sudo frp-ssh-guard reload
# Reload keeps current bans and learned entries with their remaining time;
# connection counters start again. If check or reload fails, the previous
# settings stay active: fix the reported setting and run both commands again.
# Finish a pending trial first (keep or disable). GUARD_TABLE is the exception:
# disable, edit, then enable.
# whitelist.conf and blocklist.conf work differently: they apply when saved.

# === Ports and protection switches ===
# Public frps forwarded TCP ports. Empty refuses activation unless local SSH is on.
# Port numbers below are invented examples, not a deployment configuration.
# Comma-separated ports/ranges; never include management SSH, frps control ports,
# or public HTTP(S). Enable server SSH separately below. Start listeners first.
# Example: PROTECTED_PORTS="22001,22003,23000-23010"
# Optional per-port/range global rate and burst: "22001:30:20,23000-23010:60:40"
PROTECTED_PORTS=""

# Ports/ranges to skip within PROTECTED_PORTS. Default none.
# Example: EXCLUDE_PORTS="23005,23008-23009"
EXCLUDE_PORTS=""

# PROTECT_SERVER_SSH: local SSH protection switch (on/off).
# Protect this server's SSH port 22, including observed authentication failures.
# Default off. When enabled, port 22 is added to the protected ports automatically.
PROTECT_SERVER_SSH=off

# JAIL_PER_PORT: jail scope switch (on/off); port rate limits remain enabled.
# Default off: a banned IP is blocked across ALL protected ports.
# On: automatic and authentication bans apply only to the offending port.
# Switching mode affects NEW bans only. Existing shared bans stay shared;
# existing per-port bans keep their original ports and absolute expiry.
# Strike history retains each offense's original scope across mode switches.
# Explicit manual block scopes are independent of this switch.
JAIL_PER_PORT=off

# SSH_SLOW_PROTECTION: slow brute-force switch (on/off). Default on.
# Bans sources that stay under the per-minute limits below but keep trying.
# Custom/FRP ports count new connections (the tunnel hides logins):
#   JAIL_PER_PORT=off: more than SSH_SLOW_TOTAL_CONNECTIONS (default 300) from one
#     source across all custom ports within SSH_SLOW_WINDOW: banned on all ports.
#   JAIL_PER_PORT=on: more than SSH_SLOW_PORT_CONNECTIONS (default 100) from one
#     source on one port within SSH_SLOW_WINDOW: banned on that port.
# Port 22, only when PROTECT_SERVER_SSH=on: SSH_SLOW_FAILURES failed logins
#   (default 20) within SSH_SLOW_WINDOW: banned with the jail scope above.
# Addresses in whitelist.conf (any port) are known administrators and are never
# counted. Bans last BAN_TIMEOUT and are written to the activity log.
# Off: no slow detection and no slow bans. The faster limits below still apply.
SSH_SLOW_PROTECTION=on

# === Detection thresholds ===
# Local sshd journal outcomes only; attempted passwords are never read or stored.
# Count repeated invalid-user connections or failed authentications in this window.
SSH_AUTH_FAILURES=5
SSH_INVALID_USER_FAILURES=3
SSH_AUTH_WINDOW=10m

# Slow brute-force thresholds, used when SSH_SLOW_PROTECTION=on (1–1000000).
# Custom ports, JAIL_PER_PORT=off: new connections per source across all ports.
SSH_SLOW_TOTAL_CONNECTIONS=300
# Custom ports, JAIL_PER_PORT=on: new connections per source on one port.
SSH_SLOW_PORT_CONNECTIONS=100
# Port 22 with PROTECT_SERVER_SSH=on: failed logins per source.
SSH_SLOW_FAILURES=20
# Window for all three: positive integer + s/m/h/d/w. Connection counts refill
# gradually across the window, so they are approximate. Default 24 hours.
SSH_SLOW_WINDOW=24h

# Activity log frp-ssh-guard.log, beside whitelist.conf and blocklist.conf:
# one line per ban (with its reason and end time), manual ban, release, strike
# escalation, accepted settings, new-source login and suspected subnet cluster.
# Newest first; at this size the oldest lines are deleted (no archives).
# 1KiB–100MiB. Default 10MiB.
LOG_MAX_SIZE=10MiB
# Report suspected subnet clusters only; never automatically block a subnet.
# Count distinct automatically banned sources per jail scope (IPv4 /24, IPv6 /64).
SUBNET_REPORT_MIN_SOURCES=5
SUBNET_REPORT_WINDOW=24h

# === Connection limits and ban duration ===
# Per source AND destination port: sustained new SYN packets/minute, not logins.
# Positive integers 1–1000000. Default 2/minute with a burst allowance of 40.
# Shared NAT/VPN users count together. Bursts replenish over time, not per minute.
PER_IP_RATE=2
PER_IP_BURST=40

# Shared new SYN ceiling per destination port (shared across IPv4/IPv6).
# Positive integers 1–1000000. Default 30/minute, burst 20. Excess is dropped;
# the shared limit alone does not add IP bans. Per-port overrides take precedence.
GLOBAL_RATE=30
GLOBAL_BURST=20

# Base source ban when the per-source or local authentication limit is exceeded.
# Scope is all protected ports unless JAIL_PER_PORT=on.
# Positive integer + s/m/h/d/w (seconds/minutes/hours/days/weeks). Default 12 hours.
# For a PERMANENT block, write the address in blocklist.conf with no time, or run
# sudo frp-ssh-guard block 203.0.113.10 (see blocklist.conf for more examples).
BAN_TIMEOUT=12h

# LEARN_ADMINS: trust administrators automatically (on/off). Default on.
# When root, the account that owns this settings folder, or a member of the
# sudo, admin or wheel group logs in successfully to THIS server's sshd, the
# source IP is added to whitelist.conf for LEARN_TIMEOUT: it is then never banned
# or counted on any protected port. No usernames need to be typed in.
# Everyone sharing that public IP (for example an office NAT) is trusted too.
# Logins to SSH servers behind FRP are invisible here and teach nothing.
# Learned sources are also exempted from an existing fail2ban sshd jail.
LEARN_ADMINS=on

# Optional extra accounts that teach trust the same way: grep extended regex,
# e.g. "alice|bob". Default empty. Use only for trusted operator accounts.
LOGIN_USERS=""

# Maximum learned addresses (integer 1–1000000); oldest entries evicted. Default 500.
MAX_LEARNED=500
# Learned-address timeout: positive integer + s/m/h/d/w; default 90 days.
# Trusted successful logins refresh this expiry; apply/reload/reboot do not.
LEARN_TIMEOUT=90d

# Repeat offenders: an automatic ban that comes within STRIKE_WINDOW after the
# source's previous ban ENDED moves one step up STRIKE_LADDER, and a source at the
# top step keeps getting the top duration. Staying clean for STRIKE_WINDOW after
# a ban ends starts over at BAN_TIMEOUT. Positive integer + s/m/h/d/w. Default 90 days.
# Bans are sampled every minute: short bans and repeated events may be missed.
STRIKE_WINDOW=90d
# Increasing "step:duration" pairs, steps >=2. Empty disables escalation.
# Default: 1st ban=BAN_TIMEOUT (12 hours), 2nd=3 days, 3rd=7 days, 4th=30 days,
# 5th or more=90 days. Durations count from the latest offense.
STRIKE_LADDER="2:3d 3:7d 4:30d 5:90d"
# Maximum strike duration from the latest offense. Default 90 days.
# The strike helper caps ladder durations at this value.
STRIKE_MAX=90d

# Advanced settings (usually leave unchanged).
# Allowed protected-port bounds, inclusive, integers 1–65535. Defaults cover all TCP.
PORT_MIN=1
PORT_MAX=65535
# Local account owning command-managed lists. Default root; trusted accounts only.
EDIT_USER=root
# Dedicated nftables table identifier. One guard instance is supported.
# Default below; to change while active: disable first, then enable with new name.
GUARD_TABLE=frp_ssh_persistent_guard
